# Everything here is optional for local development.

# Public address of the site. Used for canonical links, the sitemap, and links in emails.
# Session cookies are marked Secure when this starts with https.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postgres connection string. Leave empty to use the embedded database in ./.data
# DATABASE_URL=postgres://user:password@host:5432/coostina

# Random secret used to hash IP addresses for rate limiting. Required in production.
# Generate one with: openssl rand -hex 32
# APP_SECRET=

# First admin account, created by `npm run db:seed`.
# If ADMIN_PASSWORD is empty, the seed script generates one and prints it once.
ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=

# Chat assistant in the bottom-right corner. Get a key at https://console.anthropic.com/settings/keys
# Without it the chat still opens, but tells guests to call instead.
# ANTHROPIC_API_KEY=

# Email via Resend. Without a key, the site logs that an email was skipped and carries on.
# RESEND_API_KEY=
# EMAIL_FROM=Coostina <booking@your-domain.no>
# EMAIL_TO_RESTAURANT=post@your-domain.no
